            "confidence": "high",
            "findingId": "csf_1f8a1050145ced710edb9574",
            "occurrenceId": "occ_37e8e19d3f2cbf1a587d3103",
            "severity": "high"
          },
          "ruleId": "gopress/posts-auth-default-disabled",
          "ruleIndex": 0
